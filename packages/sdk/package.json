{
  "name": "@aurik/sdk",
  "version": "0.0.1",
  "description": "Official Aurik Identity SDK",
  "publishConfig": { 
    "access": "public" 
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@aurik/typescript-config": "workspace:*",
    "@types/node": "^20"
  }
}
